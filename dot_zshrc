# .zshrc
[[ -r ~/Git/znap/znap.zsh ]] ||
    git clone --depth 1 -- \
        https://github.com/marlonrichert/zsh-snap.git ~/Git/znap
zstyle ':znap:*' repos-dir ~/Git/znap/plugins
source ~/Git/znap/znap.zsh  # Start Znap

znap prompt sindresorhus/pure

if [[ "$(cat /etc/hostname)" == "mightytower" ]]; then
    source /usr/share/zsh/plugins/zsh-autocomplete/zsh-autocomplete.plugin.zsh
elif [[ "$(cat /etc/hostname)" == "raspberrypi" || "mightybuntu" ]]; then
    source "/home/linuxbrew/.linuxbrew/Cellar/zsh-autocomplete/26.08.04/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh"
else
    source /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh
fi
znap source michel-kraemer/zsh-patina

znap eval zoxide 'zoxide init --cmd cd zsh'
znap eval docker 'docker completion zsh'

alias ls='eza -l --icons=auto'
alias la='ls -a'
alias oc='opencode'
alias ocs='source $HOME/Git/fpga/oss-cad-suite/environment'

export PATH=$PATH:$HOME/.go/bin

bindkey -e
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' forward-word
