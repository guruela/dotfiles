maximize = true

window-padding-x = 14
window-padding-y = 14

font-size = 18

theme = Dracula
background = #000000

background-opacity = 0.8
background-blur = true

macos-option-as-alt = true

shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = true

custom-shader = shaders/cursor_warp.glsl

